# =============================================================================
# Evidence Integrity Platform - Environment Configuration Template
# =============================================================================

# Server Security & Secret Keys (Generate with `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret
SIGNER_PRIVATE_KEY=
SIGNER_KEY_PASSPHRASE=

# Session Lifetime
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false

# Storage & Database
EI_STORAGE_DIR=storage
DATABASE_URL=sqlite:///storage/evidence.db

# Multi-Modal Language Intelligence & Offline Privacy Controls
# Options: none (100% offline air-gapped mode) | free_online | gemini | groq | ollama | openai
LLM_PROVIDER=free_online
LLM_MODEL=openai
LLM_API_KEY=
LLM_BASE_URL=

# Upload Limits & Rate Limiting
MAX_UPLOAD_BYTES=524288000
LOGIN_MAX_FAILS=5
LOGIN_BLOCK_SECONDS=900
